CREDITFLOW_ENV=local
CREDITFLOW_RUNTIME_BACKEND=postgres
CREDITFLOW_MOCK_LLM_MODE=true
CREDITFLOW_LOCAL_AUTH_ENABLED=true
CREDITFLOW_DATABASE_URL=postgresql+asyncpg://creditflow:creditflow-local-only@postgres:5432/creditflow
CREDITFLOW_CHECKPOINT_DATABASE_URL=postgresql://creditflow:creditflow-local-only@postgres:5432/creditflow
CREDITFLOW_REDIS_URL=redis://redis:6379/0
CREDITFLOW_S3_ENDPOINT_URL=http://minio:9000
CREDITFLOW_S3_BUCKET=creditflow-documents
CREDITFLOW_S3_SSE_ALGORITHM=AES256
CREDITFLOW_S3_KMS_KEY_ID=
CREDITFLOW_AWS_REGION=us-east-1
CREDITFLOW_SQS_QUEUE_URL=http://localstack:4566/000000000000/creditflow-jobs
CREDITFLOW_SQS_ENDPOINT_URL=http://localstack:4566
CREDITFLOW_OIDC_ISSUER=
CREDITFLOW_OIDC_JWKS_URL=
CREDITFLOW_OIDC_AUDIENCE=creditflow-api
CREDITFLOW_OPENAI_API_KEY=
CREDITFLOW_OPENAI_MODEL=gpt-5-mini
CREDITFLOW_ANTHROPIC_API_KEY=
CREDITFLOW_ANTHROPIC_MODEL=claude-sonnet-4-5
CREDITFLOW_BEDROCK_MODEL=
CREDITFLOW_LITELLM_ENABLED=false
CREDITFLOW_LLM_SIMPLE_ALIAS=credit-simple
CREDITFLOW_LLM_COMPLEX_ALIAS=credit-complex
CREDITFLOW_SENSITIVE_LLM_CACHE_ENABLED=false
CREDITFLOW_MCP_AUTH_TOKEN=local-mcp-token-change-me
CREDITFLOW_LANGSMITH_TRACING=false
