{"title":"CreditFlow Operations","uid":"creditflow-ops","schemaVersion":41,"refresh":"15s","panels":[{"type":"timeseries","title":"Requests/sec","targets":[{"expr":"sum(rate(creditflow_http_requests_total[5m]))"}],"gridPos":{"x":0,"y":0,"w":8,"h":8}},{"type":"timeseries","title":"API latency p50/p95/p99","targets":[{"expr":"histogram_quantile(0.50,sum(rate(creditflow_http_request_duration_seconds_bucket[5m])) by (le))"},{"expr":"histogram_quantile(0.95,sum(rate(creditflow_http_request_duration_seconds_bucket[5m])) by (le))"},{"expr":"histogram_quantile(0.99,sum(rate(creditflow_http_request_duration_seconds_bucket[5m])) by (le))"}],"gridPos":{"x":8,"y":0,"w":8,"h":8}},{"type":"stat","title":"Cases awaiting review","targets":[{"expr":"creditflow_cases_awaiting_review"}],"gridPos":{"x":16,"y":0,"w":8,"h":8}},{"type":"timeseries","title":"Retrieval latency","targets":[{"expr":"histogram_quantile(0.95,sum(rate(creditflow_retrieval_duration_seconds_bucket[5m])) by (le,strategy))"}],"gridPos":{"x":0,"y":8,"w":8,"h":8}},{"type":"timeseries","title":"LLM latency by provider","targets":[{"expr":"histogram_quantile(0.95,sum(rate(creditflow_llm_duration_seconds_bucket[5m])) by (le,provider,model))"}],"gridPos":{"x":8,"y":8,"w":8,"h":8}},{"type":"timeseries","title":"Input/output tokens","targets":[{"expr":"sum(rate(creditflow_llm_tokens_total[5m])) by (direction,provider)"}],"gridPos":{"x":16,"y":8,"w":8,"h":8}},{"type":"timeseries","title":"Cache hit ratio","targets":[{"expr":"sum(rate(creditflow_cache_operations_total{result=\"hit\"}[5m])) / clamp_min(sum(rate(creditflow_cache_operations_total[5m])),1)"}],"gridPos":{"x":0,"y":16,"w":8,"h":8}},{"type":"timeseries","title":"Model/workflow errors","targets":[{"expr":"sum(rate(creditflow_workflow_failures_total[5m])) by (node,error_type)"}],"gridPos":{"x":8,"y":16,"w":8,"h":8}}]}
